rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Connection test document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Helper functions
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 100 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidScoreData(data) {
      return data.keys().hasAll(['id', 'playerName', 'score', 'mode'])
        && data.playerName is string
        && data.playerName.size() > 0
        && data.playerName.size() <= 80
        && data.score is number
        && data.score >= 0
        && (data.mode == 'slingshot' || data.mode == 'quiz');
    }

    // Public Global Leaderboard for worldwide players
    match /scores/{scoreId} {
      allow read: if true;
      allow create: if isValidId(scoreId) && isValidScoreData(request.resource.data);
      allow update: if isValidId(scoreId) && isValidScoreData(request.resource.data);
      allow delete: if isValidId(scoreId);
    }
  }
}
